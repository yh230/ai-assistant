# Copy to .env.local before running `npm run dev`.
# Backend base URL used by the axios client and the screen SSE stream.
VITE_API_BASE_URL=/api
# Serve every page from the local fixtures in src/mock/ without a backend.
# Set to true for a backend-free preview; mock data is not correctness evidence.
VITE_USE_MOCK=false
# Optional dev-server proxy target for the FastAPI backend.
VITE_API_PROXY=http://127.0.0.1:8000
