# E2E 测试配置模板：复制为 .env 并填入真实值（.env 不入库）
E2E_BASE_URL=http://localhost:8080

# 平台管理员（未绑定医院；Seeder 播种默认 admin/admin123）
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=admin123

# 医院 1 的员工账号（须绑定 E2E_HOSPITAL1_NAME 对应医院）
E2E_STAFF1_USER=
E2E_STAFF1_PASSWORD=

# 医院 2 的员工账号（须绑定 E2E_HOSPITAL2_NAME 对应医院）
E2E_STAFF2_USER=
E2E_STAFF2_PASSWORD=

# 可选：非 admin 的院长账号，用于安全用例 test_07_security_hardening 的角色下拉收敛校验；
# 未配置时该用例回退 staff1，若其缺少 hospital:employee:list 则 skip。
# E2E_HOSPITAL_DIRECTOR_USER=
# E2E_HOSPITAL_DIRECTOR_PASSWORD=

# 两家演示医院名称（须与 hospital_db.hospital 数据一致）
E2E_HOSPITAL1_NAME=
E2E_HOSPITAL2_NAME=

# 超时（秒）：普通请求 / LLM 流式读
E2E_FAST_TIMEOUT=20
E2E_LLM_TIMEOUT=120

# MCP SSE 端到端（可选；未配置 API Key 时 test_09 自动跳过）
# MCP_E2E_BASE_URL 默认复用 E2E_BASE_URL
MCP_E2E_BASE_URL=
MCP_E2E_API_KEY=
# 可选：限定医院；为空时使用 Key 返回的第一家医院
MCP_E2E_HOSPITAL_ID=

# 结果推送（可空=不推送；多通道逗号分隔：wecom,feishu,email）
E2E_NOTIFY_CHANNELS=

# 企业微信机器人 webhook（群机器人）
E2E_WECOM_WEBHOOK=

# 飞书机器人 webhook（群机器人）
E2E_FEISHU_WEBHOOK=

# SMTP 邮件（SSL 端口 465；FROM 留空则用 USER；TO 逗号分隔收件人）
E2E_SMTP_HOST=
E2E_SMTP_PORT=465
E2E_SMTP_USER=
E2E_SMTP_PASSWORD=
E2E_SMTP_FROM=
E2E_SMTP_TO=
